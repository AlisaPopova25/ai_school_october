# Python / IDE
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.idea/
*.part

# Датасет (2.3 ГБ) не храним в git — ссылка и скрипт загрузки в data/README.md
data/*
!data/README.md

# Всё, что пишет код при запуске (папки создаются сами; снимок результатов — в results/),
# кроме готовых признаков, на которых анализ работает без датасета
outputs/*
!outputs/features/
!outputs/repro/
outputs/repro/*
!outputs/repro/ext_features/
