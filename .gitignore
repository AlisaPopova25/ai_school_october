# Python / IDE
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.idea/
*.part

# Датасет (2.3 ГБ) не храним в git — ссылка и скрипт загрузки в data/README.md
data/**/*.txt
data/*.txt
!data/**/.gitkeep
data/mesa/*
!data/mesa/.gitkeep

# Промежуточные и пересчитываемые файлы (снимок результатов — в results/)
outputs/cropped/*
!outputs/cropped/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/logs/
outputs/*.log
outputs/repro/*
!outputs/repro/ext_features/
